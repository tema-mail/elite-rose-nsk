---
import Base from '../layouts/Base.astro';
import HeroLux from '../components/HeroLux.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import WhyLux from '../components/WhyLux.astro';
import ImageCard from '../components/ImageCard.astro';
import Stats from '../components/Stats.astro';
import QuizSection from '../components/QuizSection.astro';
import DeliveryCards from '../components/DeliveryCards.astro';
import Faq from '../components/Faq.astro';
import ContactCard from '../components/ContactCard.astro';
import Catalog from '../islands/Catalog';
import { products, toCard, inPart, allChips, PART } from '../lib/catalog';

const all = products.filter((p) => p.price && p.images.length).map(toCard);
const big = products.filter((p) => inPart(p, PART.big)).sort((a, b) => (a.price ?? 0) - (b.price ?? 0)).map(toCard);
const photo = (title: string) => (products.find((p) => p.title === title)?.images[0] ?? '') + '-1000.webp';

const faq = [
  { q: 'Как быстро вы доставляете цветы?', a: 'По Новосибирску доставка от 60 минут. Точное время зависит от заказа, адреса и времени доставки – согласуем при оформлении.' },
  { q: 'Я увижу букет до доставки?', a: 'Да. Перед доставкой мы отправляем фото готового букета на согласование.' },
  { q: 'Почему у вас такие цены?', a: 'Работаем по оптовым ценам: свежие поставки цветов приходят каждые три дня.' },
  { q: 'Есть ли гарантия на цветы?', a: 'Да. На букеты действует гарантия качества 48 часов с момента доставки.' },
  { q: 'Как сделать заказ?', a: 'Оформите заказ на сайте, напишите нам ВКонтакте или позвоните по номеру +7 (923) 151-42-74.' },
  { q: 'Можно забрать букет самому?', a: 'Да, самовывоз – Новосибирск, Линейная ул., 114к2.' },
];
---
<Base title="Elite Rose – доставка цветов и роз в Новосибирске" description="Доставим свежие цветы по Новосибирску за 60 минут. Розы и букеты по оптовым ценам, поставки каждые три дня, фото перед доставкой, гарантия 48 часов.">
  <HeroLux
    kicker="Новосибирск · самые доступные цены в городе"
    title="Доставим свежие цветы с гарантией, по Новосибирску"
    accent="за 60 минут"
    text="Соберём букет для важного повода или просто без повода. Перед доставкой пришлём фото готового заказа на согласование и доставим цветы по Новосибирску от 60 минут."
    image="/img/er/hero.webp"
    buttons={[{ label: 'Выбрать букет', href: '/#catalog' }, { label: 'Помогите выбрать', href: '/#Quiz' }]}
    features={['wholesale', 'fresh', 'guarantee', 'delivery']}
  />
  <Marquee items={['Розы 60–100 см', 'Кустовые розы', 'Хризантемы', 'Гортензии', 'Корзины', 'Свадебные букеты', '101 роза', 'Метровая роза «Explorer»']} />

  <section class="section container" id="catalog">
    <SectionHead kicker="Каталог" title="Букеты на каждый день" sub={`${all.length} букетов и композиций с доставкой по Новосибирску`} action={{ label: 'Весь каталог', href: '/catalog' }} />
    <Catalog client:visible cards={all} chips={allChips()} step={8} />
  </section>

  <WhyLux
    id="preim"
    kicker="Почему Elite Rose"
    title="Выбирают снова и снова"
    lead="Когда хочется порадовать близкого человека, важно не просто заказать цветы – хочется быть уверенным, что всё получится именно так, как вы задумали."
    image="/img/er/roses-2.webp"
    items={[
      { title: 'Свежие цветы по оптовым ценам', text: 'Поставки приходят каждые три дня, а цены – самые доступные в городе.' },
      { title: 'Авторские букеты и композиции из роз', text: 'От 15 кустовых роз до корзины из 1001 розы и метровых роз «Explorer».' },
      { title: 'Фото перед доставкой', text: 'Пришлём готовый букет на согласование и доставим по городу от двери до двери.' },
      { title: 'Гарантия 48 часов и 5% бонусов', text: 'Отвечаем за свежесть, а с каждого заказа начисляем бонусы на следующую покупку.' },
    ]}
    buttons={[{ label: 'Выбрать букет', href: '/catalog' }, { label: 'Написать ВКонтакте', href: 'https://vk.me/elite_rose_nsk' }]}
  />

  <Stats stats={[{ value: String(all.length), label: 'букетов в каталоге' }, { value: '1001', label: 'роза – самый большой букет' }, { value: '3 дня', label: 'между свежими поставками' }]} />

  <ImageCard
    kicker="Гарантии"
    title="За что мы отвечаем в каждом заказе"
    text="Когда вы заказываете цветы для близкого человека, важно быть уверенным не только в том, как будет выглядеть букет, но и в том, как он будет собран и доставлен."
    image={photo('Корзина из 201 розы')}
    buttons={[{ label: 'Смотреть каталог', href: '/catalog' }, { label: 'Помогите выбрать', href: '/#Quiz' }]}
  />

  <section class="section container">
    <SectionHead kicker="Вау-эффект" title="От 51 до 1001 розы" sub="Большие букеты для тех, кто хочет удивить" action={{ label: 'Все большие букеты', href: '/catalog?part=big' }} />
    <Catalog client:visible cards={big} step={4} prices={false} sort={false} />
  </section>

  <QuizSection />
  <DeliveryCards />
  <Faq items={faq} />
  <ImageCard
    align="right"
    kicker="Elite Rose"
    title="Хотите порадовать близкого человека уже сегодня?"
    text="Выберите готовый букет в каталоге или расскажите нам, кому и по какому поводу нужны цветы. Флорист поможет с выбором, а перед доставкой мы пришлём фото готового заказа."
    image="/img/er/roses-3.webp"
    buttons={[{ label: 'Выбрать букет', href: '/catalog' }, { label: 'Помогите выбрать', lead: true }]}
  />
  <ContactCard />
</Base>
