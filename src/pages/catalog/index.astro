---
import Base from '../../layouts/Base.astro';
import HeroLux from '../../components/HeroLux.astro';
import SectionHead from '../../components/SectionHead.astro';
import QuizSection from '../../components/QuizSection.astro';
import ContactCard from '../../components/ContactCard.astro';
import Catalog from '../../islands/Catalog';
import { products, toCard, allChips } from '../../lib/catalog';

const all = products.filter((p) => p.price && p.images.length).map(toCard);
const min = Math.min(...all.map((p) => p.price));
---
<Base title="Каталог цветов и букетов с доставкой по Новосибирску – Elite Rose" description={`Каталог Elite Rose: ${all.length} букетов из роз, хризантем и гортензий от ${min.toLocaleString('ru-RU')} ₽ с доставкой по Новосибирску. Фото перед доставкой.`}>
  <HeroLux
    compact
    kicker="Каталог Elite Rose"
    title="Цветы и букеты в Новосибирске"
    text={`Розы от 60 до 100 см, кустовые розы, хризантемы, гортензии, корзины и свадебные букеты – от ${min.toLocaleString('ru-RU')} ₽. Перед доставкой пришлём фото готового заказа.`}
    image="/img/er/roses-3.webp"
    buttons={[{ label: 'Смотреть букеты', href: '/catalog#list' }, { label: 'Помогите выбрать', href: '/catalog#Quiz' }]}
  />
  <section class="section container" id="list">
    <SectionHead kicker="Каталог" title="Все букеты" sub={`${all.length} букетов от ${min.toLocaleString('ru-RU')} ₽`} />
    <Catalog client:load cards={all} chips={allChips()} step={16} />
  </section>
  <QuizSection />
  <ContactCard />
</Base>
