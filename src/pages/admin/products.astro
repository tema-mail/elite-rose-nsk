---
// Раздел «Товары»: те же товары, что в каталоге и блоках товаров на главной (src/data/products.json).
// Скрытые тоже здесь – на сайте их нет.
import Admin from '../../layouts/Admin.astro';
import ProductsAdmin from '../../islands/admin/ProductsAdmin';
import { allProducts, parts } from '../../lib/catalog';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Admin title="Товары" active="products">
  <ProductsAdmin client:load items={allProducts} parts={parts} base={base} />
</Admin>
