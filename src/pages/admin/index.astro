---
// Страницы сайта по сущностям (как в админке Evolution CB): Главная, Каталог (раскрывается – внутри разделы
// и карточки товара), Технические страницы.
import Admin from '../../layouts/Admin.astro';
import { allProducts as products, parts, inPart } from '../../lib/catalog';
import { u } from '../../lib/url';
const site = (p: string) => new URL(u(p), Astro.site).href;
const tech = [
  { name: 'Оформление заказа', path: '/order' },
  { name: 'Избранное', path: '/favorites' },
  { name: 'Спасибо', path: '/thanks' },
  { name: 'Страница не найдена', path: '/404' },
];
const total = 2 + products.length + tech.length;
---
<Admin title="Страницы сайта" active="pages">
  <div class="tools">
    <h1>Страницы сайта</h1>
    <span class="muted">{total} страниц</span>
    <a class="btn" href={u('/')} target="_blank">Открыть сайт ↗</a>
  </div>
  <div class="pages">
    <div class="phead"><span></span><span>Страница</span><span>Адрес</span><span style="text-align:right">Сущность</span></div>

    <div class="pgroup">Главная <span>1</span></div>
    <div class="prow">
      <img class="thumb" src={u('/img/er/hero.webp')} alt="" />
      <div><span class="pname">Главная</span><div class="muted" style="font-size:12px">Elite Rose – доставка цветов и роз в Новосибирске</div></div>
      <a class="purl" href={u('/')} target="_blank">{site('/')}</a>
      <span class="pkind">Главная</span>
    </div>

    <div class="pgroup">Каталоги <span>1 · {products.length} карточек товара</span></div>
    <details class="pcat">
      <summary class="prow">
        <img class="thumb" src={u('/img/er/roses-3.webp')} alt="" />
        <div><span class="pname"><i class="caret"></i>Общий каталог</span><div class="muted" style="font-size:12px">{products.length} товаров · {parts.length} разделов</div></div>
        <a class="purl" href={u('/catalog')} target="_blank">{site('/catalog')}</a>
        <span class="pkind">Каталог</span>
      </summary>
      {parts.map((pt) => (
        <div class="prow lvl1">
          <span></span>
          <div><span class="pname">Раздел «{pt.title}»</span><div class="muted" style="font-size:12px">{products.filter((p) => inPart(p, pt.id)).length} товаров</div></div>
          <a class="purl" href={u(`/catalog?part=${pt.id}`)} target="_blank">/catalog?part={pt.id}</a>
          <span class="pkind">Раздел каталога</span>
        </div>
      ))}
      {products.map((p) => (
        <div class="prow lvl1">
          <img class="thumb" src={u(p.images[0] + '-480.webp')} alt="" loading="lazy" />
          <div><span class="pname">{p.title}{p.hidden && <span class="chip" style="margin-left:8px">скрыт</span>}</span><div class="muted" style="font-size:12px">{p.price?.toLocaleString('ru-RU')} ₽</div></div>
          <a class="purl" href={u(p.path)} target="_blank">{p.path}</a>
          <span class="pkind">Карточка товара</span>
        </div>
      ))}
    </details>

    <div class="pgroup">Технические страницы <span>{tech.length}</span></div>
    {tech.map((t) => (
      <div class="prow">
        <span></span>
        <span class="pname">{t.name}</span>
        <a class="purl" href={u(t.path)} target="_blank">{site(t.path)}</a>
        <span class="pkind">Техническая</span>
      </div>
    ))}
  </div>
</Admin>
