---
// Первый экран Elite Rose: фото на всю ширину с медленным зумом, текст появляется по очереди.
import Btn, { type BtnProps } from './Btn.astro';
import { u } from '../lib/url';
import { FEATURE, type FeatureKey } from '../lib/site';
import { FeatureIcon } from '../islands/icons';
interface Props { kicker?: string; title: string; accent?: string; text?: string; image: string; buttons?: BtnProps[]; features?: FeatureKey[]; compact?: boolean }
const { kicker, title, accent, text, image, buttons = [], features = [], compact = false } = Astro.props;
---
<section class:list={['hl', { 'hl--compact': compact }]}>
  <div class="hl__bg" aria-hidden="true"><img src={u(image)} alt="" fetchpriority="high" /></div>
  <div class="container hl__inner">
    {kicker && <p class="kicker hl__a" style="--d:0">{kicker}</p>}
    <h1 class="hl__title hl__a" style="--d:1">{title}{accent && <> <em>{accent}</em></>}</h1>
    {text && <p class="hl__text hl__a" style="--d:2">{text}</p>}
    {buttons.length > 0 && <div class="hl__btns hl__a" style="--d:3">{buttons.map((b, i) => <Btn {...b} variant={b.variant ?? (i === 0 ? 'white' : 'outline')} flower={b.flower ?? i === 0} />)}</div>}
    {features.length > 0 && (
      <ul class="hl__feats hl__a" style="--d:4">
        {features.map((k) => <li><span class="hl__ficon"><FeatureIcon name={FEATURE[k].icon} size={20} /></span>{FEATURE[k].text}</li>)}
      </ul>
    )}
  </div>
</section>
<style>
  .hl { position: relative; min-height: min(92vh, 900px); display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; }
  .hl--compact { min-height: min(62vh, 560px); }
  .hl__bg { position: absolute; inset: 0; z-index: -1; }
  .hl__bg img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 30%; animation: er-zoom 9s var(--ease) both; }
  .hl__bg::after { content: ''; position: absolute; inset: 0; background:
    linear-gradient(90deg, rgba(12,15,14,.96) 0%, rgba(12,15,14,.82) 34%, rgba(12,15,14,.25) 70%, rgba(12,15,14,.1) 100%),
    linear-gradient(0deg, rgba(12,15,14,1) 0%, rgba(12,15,14,0) 30%); }
  .hl__inner { display: grid; gap: 26px; padding-top: 120px; padding-bottom: 64px; }
  .hl__a { animation: er-up 1s var(--ease) both; animation-delay: calc(var(--d) * 140ms + 200ms); }
  .hl__title { max-width: 820px; font: 500 clamp(44px, 6vw, 96px)/.98 var(--head-font); color: var(--ink); letter-spacing: -.01em; }
  .hl__title em { display: inline-block; font-style: italic; color: var(--gold); }
  .hl--compact .hl__title { font-size: clamp(38px, 4.6vw, 72px); }
  .hl__text { max-width: 520px; font-size: 16px; line-height: 1.65; color: var(--text); }
  .hl__btns { display: flex; flex-wrap: wrap; gap: 14px; }
  .hl__feats { list-style: none; margin: 34px 0 0; padding: 26px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .hl__feats li { display: flex; align-items: center; gap: 14px; padding-right: 20px; font-size: 13.5px; color: var(--ink); }
  .hl__feats li + li { padding-left: 24px; border-left: 1px solid var(--line); }
  .hl__ficon { width: 42px; height: 42px; flex: none; border-radius: 50%; display: grid; place-items: center; color: var(--gold); box-shadow: inset 0 0 0 1px rgba(201, 169, 110, .4); }
  @media (max-width: 1023px) {
    .hl { min-height: 0; }
    .hl__bg { position: relative; height: 62vh; max-height: 560px; }
    .hl { flex-direction: column; align-items: stretch; }
    .hl__bg::after { background: linear-gradient(0deg, rgba(12,15,14,1) 2%, rgba(12,15,14,.2) 55%, rgba(12,15,14,.1) 100%); }
    .hl__inner { margin-top: -150px; padding-top: 0; padding-bottom: 32px; gap: 18px; }
    .hl__title { font-size: clamp(40px, 11vw, 56px); }
    .hl--compact .hl__bg { height: 42vh; }
    .hl--compact .hl__inner { margin-top: -110px; }
    .hl__btns { flex-direction: column; }
    .hl__btns :global(.btn) { width: 100%; }
    .hl__feats { grid-template-columns: 1fr 1fr; gap: 16px 12px; margin-top: 14px; padding-top: 20px; }
    .hl__feats li, .hl__feats li + li { padding: 0; border: 0; font-size: 12.5px; gap: 10px; }
    .hl__ficon { width: 36px; height: 36px; }
  }
</style>
