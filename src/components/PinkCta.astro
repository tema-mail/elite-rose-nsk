---
// Розовый баннер с вырезанным букетом, который выходит за верх карточки.
import Btn, { type BtnProps } from './Btn.astro';
import { img } from '../lib/img';
// photo – обычная фотография (у Elite Rose нет вырезанных PNG): занимает правую половину карточки.
const { title, text, badge, image, buttons = [], id, photo = false } = Astro.props as { title: string; text?: string; badge?: string; image: string; buttons?: BtnProps[]; id?: string; photo?: boolean };
---
<section class="section container" id={id}>
  <div class="cta pink-card reveal">
    <div class="cta__text">
      {badge && <span class="badge cta__badge">✿ {badge}</span>}
      <h2 class="h2" set:html={title.replace(/\n/g, '<br />')} />
      {text && <p class="cta__p" set:html={text.replace(/\n/g, '<br />')} />}
      {buttons.length > 0 && <div class="cta__btns">{buttons.map((b, i) => <Btn {...b} variant={b.variant ?? (i === 0 ? 'white' : 'outline')} flower={b.flower ?? i === 0} />)}</div>}
    </div>
  </div>
  <img class:list={['cta__img', { 'cta__img--photo': photo }]} src={img(image)} alt="" loading="lazy" />
</section>
<style>
  section { position: relative; }
  .cta { min-height: 500px; display: flex; align-items: center; padding: 56px; overflow: visible; }
  .cta.pink-card { overflow: hidden; }
  .cta__text { position: relative; z-index: 2; display: grid; gap: 22px; max-width: 560px; }
  .cta__badge { justify-self: start; }
  .cta__p { font-size: 14px; max-width: 470px; }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 14px; }
  .cta__img { position: absolute; z-index: 3; right: calc(var(--gutter) + 0px); bottom: 0; width: min(54%, 760px); max-height: calc(100% + 40px); object-fit: contain; object-position: bottom right; pointer-events: none; }
  .cta__img--photo { top: 0; bottom: 0; right: var(--gutter); width: min(46%, 640px); height: 100%; max-height: none; object-fit: cover; border-radius: 0 6px 6px 0; -webkit-mask-image: linear-gradient(90deg, transparent, #000 30%); mask-image: linear-gradient(90deg, transparent, #000 30%); }
  @media (max-width: 1023px) {
    .cta__img--photo { top: auto; height: 320px; width: calc(100% - 2 * var(--gutter)); left: var(--gutter); transform: none; border-radius: 0 0 6px 6px; -webkit-mask-image: linear-gradient(180deg, transparent, #000 35%); mask-image: linear-gradient(180deg, transparent, #000 35%); }
    .cta { flex-direction: column; align-items: stretch; min-height: 0; padding: 28px 20px 320px; }
    .cta__btns { flex-direction: column; }
    .cta__btns :global(.btn) { width: 100%; }
    .cta__img { left: 50%; right: auto; transform: translateX(-50%); width: min(92%, 420px); max-height: 330px; }
  }
</style>
