---
// Заглушка раздела админки: что здесь будет и что нужно, чтобы заработало (как в Evolution CB).
const { title, lead, items, needs } = Astro.props as { title: string; lead: string; items: string[]; needs: string };
---
<div style="max-width:760px;margin:0 auto">
  <div class="panel">
    <h2>{title}</h2>
    <p style="margin:0 0 12px;color:#55605d">{lead}</p>
    <ul style="margin:0;padding-left:20px;line-height:1.9">{items.map((i) => <li>{i}</li>)}</ul>
  </div>
  <div class="panel" style="border-color:#f0d9a8;background:#fffaf0">
    <h2 style="font-size:14px">Чтобы раздел заработал, нужно</h2>
    <p style="margin:0;color:#55605d">{needs}</p>
  </div>
</div>
