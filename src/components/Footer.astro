---
import { SITE, SOCIALS, FOOTER } from '../lib/site';
import { u } from '../lib/url';
import { Social } from '../islands/icons';
import Logo from './Logo.astro';
const cols = [
  { title: 'Меню', items: FOOTER.menu },
  { title: 'Каталог', items: FOOTER.catalog },
  { title: 'Покупателям', items: FOOTER.buyers },
  { title: 'Информация', items: FOOTER.info },
];
---
<footer class="ftr">
  <div class="container ftr__grid">
    <div class="ftr__brand">
      <Logo light />
      <p class="ftr__tag">Цветы и розы с доставкой по Новосибирску</p>
      <div class="ftr__contacts">
        <a href={SITE.phoneHref} class="ftr__phone">{SITE.phone}</a>
        <span>{SITE.city}, {SITE.address}</span>
        <span>{SITE.hours}</span>
      </div>
      <div class="ftr__socials">
        {SOCIALS.map((s) => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Social id={s.id} size={18} /></a>)}
      </div>
    </div>
    {cols.map((c) => (
      <nav class="ftr__col" aria-label={c.title}>
        <p class="ftr__h">{c.title}</p>
        <ul>{c.items.map((i) => <li><a href={u(i.href)}>{i.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="container ftr__legal">
    <span>© {new Date().getFullYear()} {SITE.name}, {SITE.city}</span>
  </div>
  <div class="ftr__mark" aria-hidden="true">ELITE ROSE</div>
</footer>

<style>
  .ftr { position: relative; margin-top: 110px; background: var(--page); color: rgba(255,255,255,.88); overflow: hidden; }
  .ftr__grid { display: grid; grid-template-columns: 1.4fr repeat(4, auto); gap: 40px 56px; padding-top: 64px; }
  .ftr__logo img { height: 22px; width: auto; filter: brightness(0) invert(1); }
  .ftr__tag { margin-top: 12px; font-size: 13px; }
  .ftr__contacts { display: grid; gap: 4px; margin-top: 40px; font-size: 14px; }
  .ftr__phone { font-weight: 600; font-size: 16px; color: #fff; }
  .ftr__socials { display: flex; gap: 8px; margin-top: 20px; }
  .ftr__socials a { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.14); color: #fff; transition: background-color .2s, color .2s; }
  .ftr__socials a:hover { background: var(--mauve); color: var(--page); }
  .ftr__h { font: 600 13px/1 var(--body-font); letter-spacing: .28em; text-transform: uppercase; color: #fff; margin-bottom: 16px; }
  .ftr__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .ftr__col a { font-size: 14px; transition: color .2s; }
  .ftr__col a:hover { color: var(--mauve); }
  .ftr__legal { padding-top: 48px; font-size: 12px; opacity: .7; }
  .ftr__mark { padding-top: 24px; font: 500 clamp(64px, 17vw, 270px)/.78 var(--head-font); letter-spacing: .04em; color: rgba(230, 211, 179, .1); white-space: nowrap; text-align: center; overflow: hidden; }
  @media (max-width: 1023px) {
    .ftr { margin-top: 72px; padding-bottom: 80px; }
    .ftr__grid { grid-template-columns: 1fr 1fr; gap: 32px 20px; padding-top: 44px; }
    .ftr__brand { grid-column: 1 / -1; }
    .ftr__contacts { margin-top: 24px; }
    .ftr__legal { padding-top: 32px; }
    .ftr { padding-bottom: 0; }
  }
</style>
