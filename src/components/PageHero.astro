---
// Первый экран страницы: розовая карточка с заголовком и кнопками + фото, ниже 4 плитки преимуществ.
import Btn, { type BtnProps } from './Btn.astro';
import Crumbs from './Crumbs.astro';
import { img, srcset } from '../lib/img';
import { FEATURE, type FeatureKey } from '../lib/site';
import { FeatureIcon } from '../islands/icons';

interface Props {
  title: string;
  accent?: string;
  text?: string;
  badge?: string;
  image: string;
  crumbs?: { label: string; href?: string }[];
  buttons?: BtnProps[];
  features?: FeatureKey[] | false;
  /** Вместо плиток – строки реквизитов (страница контактов). */
  facts?: string[];
  small?: boolean;
}
const { title, accent, text, badge, image, crumbs, buttons = [], features = ['wholesale', 'fresh', 'guarantee', 'delivery'], facts, small = false } = Astro.props;
---
<section class:list={['hero container', { 'hero--small': small }]}>
  <div class="hero__grid">
    <div class="hero__card pink-card">
      {crumbs && <Crumbs items={crumbs} />}
      {badge && <span class="badge hero__badge">{badge}</span>}
      <h1 class="h1 hero__title">{title}{accent && <> <span class="hero__accent">{accent}</span></>}</h1>
      {text && <p class="hero__text" set:html={text.replace(/\n/g, '<br />')} />}
      {buttons.length > 0 && <div class="hero__btns">{buttons.map((b, i) => <Btn {...b} variant={b.variant ?? (i === 0 ? 'white' : 'outline')} flower={b.flower ?? i === 0} />)}</div>}
    </div>
    <div class="hero__photo">
      <img src={img(image)} srcset={srcset(image)} sizes="(max-width: 1023px) 100vw, 50vw" alt="" fetchpriority="high" />
    </div>
  </div>
  {facts ? (
    <div class="hero__facts">{facts.map((f) => <p>{f}</p>)}</div>
  ) : features && (
    <ul class="hero__features">
      {features.map((k) => (
        <li><span class="hero__ficon"><FeatureIcon name={FEATURE[k].icon} /></span><span>{FEATURE[k].text}</span></li>
      ))}
    </ul>
  )}
</section>

<style>
  .hero { padding-top: 16px; }
  .hero__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .hero__card { display: flex; flex-direction: column; justify-content: center; gap: 22px; min-height: 664px; padding: 64px 56px; }
  .hero--small .hero__card { min-height: 520px; }
  .hero__badge { align-self: flex-start; background: rgba(255,255,255,.25); }
  .hero__dot { color: #fff; font-size: 16px; }
  .hero__title { max-width: 620px; }
  .hero__accent { display: inline-block; margin-top: 10px; padding: 2px 22px 6px; border: 1px solid rgba(230, 211, 179, .55); border-radius: 40px; color: #f6f0e7; font-size: .72em; vertical-align: .05em; }
  .hero__text { max-width: 500px; font-size: 15px; line-height: 1.55; }
  .hero__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .hero__photo { border-radius: var(--radius-xl); overflow: hidden; background: var(--bg-soft); min-height: 100%; }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; }
  .hero__features { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .hero__features li { display: flex; align-items: center; gap: 20px; padding: 20px; border-radius: 6px; background: var(--bg-soft); font-size: 14px; color: var(--ink); line-height: 1.35; }
  .hero__ficon { width: 58px; height: 58px; flex: none; display: grid; place-items: center; border-radius: 4px; background: #1c201f; color: #e6d3b3; }
  .hero__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
  .hero__facts p { padding: 22px 28px; border-radius: 6px; background: var(--bg-soft); font: 400 clamp(17px, 1.6vw, 22px)/1.3 var(--body-font); color: var(--text); }
  @media (max-width: 1023px) {
    .hero { padding-top: 10px; }
    .hero__grid { grid-template-columns: 1fr; gap: 0; }
    .hero__photo { order: -1; height: 300px; border-radius: var(--radius-xl) var(--radius-xl) 0 0; }
    .hero__card { min-height: 0 !important; padding: 28px 20px 26px; gap: 14px; border-radius: 0 0 var(--radius-xl) var(--radius-xl); margin-top: -24px; border-radius: var(--radius-xl); }
    .hero__btns { flex-direction: column; margin-top: 8px; }
    .hero__btns :global(.btn) { width: 100%; }
    .hero__accent { padding: 0 14px 3px; }
    .hero__features { grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
    .hero__features li { flex-direction: column; align-items: flex-start; gap: 10px; padding: 14px; font-size: 12.5px; border-radius: 6px; }
    .hero__ficon { width: 40px; height: 40px; }
    .hero__facts { grid-template-columns: 1fr; gap: 10px; margin-top: 10px; }
    .hero__facts p { padding: 16px 18px; }
  }
</style>
